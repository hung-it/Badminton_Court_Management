# Booking payment provider configuration example
# Required: SELECT u.id FROM users u JOIN customers c ON c.user_id=u.id WHERE u.email='guest@bcm.com';
# Set the UUID of the verified dedicated guest. Missing/invalid configuration stops startup.
BCM_POS_GUEST_USER_ID=

BOOKING_PAYMENT_ENABLED_METHODS=VNPAY
BOOKING_HOLD_DURATION=PT10M

BOOKING_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
BOOKING_VNPAY_TMN_CODE=
BOOKING_VNPAY_HASH_SECRET=
BOOKING_VNPAY_RETURN_URL=
# Optional backend Return redirect destination, e.g. http://localhost:5174/payment-result.
# The UI requests displayOnly=true to retain the verified JSON contract.
BOOKING_PAYMENT_FRONTEND_RESULT_URL=http://localhost:5174/payment-result
# IPN is configured in the merchant portal: /api/payments/vnpay/ipn (public HTTPS).
